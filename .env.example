# MN Shoes & Watches — environment variables
# Copy to .env and fill in. Never commit .env. On Hostinger, enter these in the Node.js app's
# "Environment variables" screen instead of uploading a file.

# ── Site ─────────────────────────────────────────────────────────────────────
# The public address of the shop, without a trailing slash.
APP_URL=http://localhost:3000

# Folder for everything the shop writes: database (mn.db), search index, page cache, uploads,
# backups. On a host this MUST be outside the app folder so redeploys cannot overwrite it,
# e.g. /home/u123456789/mn-data  (see DECISIONS.md 21).
DATA_DIR=./data

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs login sessions. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Encrypts API keys saved in the admin (Razorpay, Shiprocket, MSG91…). 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: if it is lost, saved API keys must be entered again.
APP_ENCRYPTION_KEY=

# ── Owner account (used once by `npm run db:seed`) ───────────────────────────
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# At least 12 characters. Change it after the first sign-in under Admin → My account.
SEED_OWNER_PASSWORD=

# ── Email (SMTP from your hosting panel) ─────────────────────────────────────
# Without these, development saves emails to DATA_DIR/outbox; production refuses to send.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. "MN Shoes & Watches <orders@mnshoes.in>"
MAIL_FROM=

# ── Google sign-in for customers (optional) ──────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Page cache (optional) ────────────────────────────────────────────────────
# Upper limit for DATA_DIR/cache.db in bytes. Default 200 MB.
# CACHE_MAX_BYTES=209715200
