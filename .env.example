# MN Shoes & Watches — environment variables
# Copy to .env and fill in. Never commit .env. On Hostinger, enter these in the Node.js app's
# "Environment variables" screen instead of uploading a file.

# ── Site ─────────────────────────────────────────────────────────────────────
# The public address of the shop, without a trailing slash.
APP_URL=http://localhost:3001

# true keeps search engines out (robots.txt blocks everything, every page says noindex). For demo
# and test copies of the shop; leave it out on the real shop.
# HIDE_FROM_SEARCH=true

# Folder for everything the shop writes: database (mn.db), search index, page cache, uploads,
# backups. On a host this MUST be outside the app folder so redeploys cannot overwrite it,
# e.g. /home/u123456789/mn-data  (see DECISIONS.md 21).
DATA_DIR=./data

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs login sessions. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Encrypts API keys saved in the admin (Razorpay, Shiprocket, MSG91…). 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: if it is lost, saved API keys must be entered again.
APP_ENCRYPTION_KEY=

# ── Admin login (the owner account, created by `npm run seed` / `npm run db:seed`) ──
# Sign in at {APP_URL}/admin. Left empty in development, the seed uses admin@example.com with the
# password MnShoes-Admin-2026. Production refuses to seed without your own values, and refuses that
# documented password. At least 12 characters. Change it later under Admin → My account.
# (The older SEED_OWNER_EMAIL / SEED_OWNER_NAME / SEED_OWNER_PASSWORD names still work.)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Owners and managers must add a sign-in code from an authenticator app (two-factor) before using
# the admin in production. "false" turns that off; "true" also asks for it in development.
# ADMIN_REQUIRE_2FA=

# ── Online payments (optional) ───────────────────────────────────────────────
# From the Razorpay dashboard → Account & Settings → API keys. Without them, checkout offers
# cash on delivery and a clearly labelled demo payment that charges nothing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email (SMTP from your hosting panel) ─────────────────────────────────────
# Without these, development saves emails to DATA_DIR/outbox; production refuses to send.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. "MN Shoes & Watches <orders@mnshoes.in>"
MAIL_FROM=

# ── Google sign-in for customers (optional) ──────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Uploaded photos (optional) ───────────────────────────────────────────────
# Uploads are saved in DATA_DIR/uploads and served from /media. Set this only when they are copied
# to a CDN or bucket (R2, Bunny); it replaces /media in image addresses.
# MEDIA_PUBLIC_URL=

# ── Page cache (optional) ────────────────────────────────────────────────────
# Upper limit for DATA_DIR/cache.db in bytes. Default 200 MB.
# CACHE_MAX_BYTES=209715200
