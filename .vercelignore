# Never upload these with a `vercel` CLI deploy (the demo normally builds from GitHub, which has none of them).
# Local secrets and the local database:
.env
.env.*
!.env.example
# (leading slashes: a bare "data/" would also drop the source folder lib/data/)
/data/
/demo-seed/
# Build output and test reports:
/.next/
/node_modules/
/test-results/
/playwright-report/
/.lighthouseci/
/screenshots/
/coverage/
