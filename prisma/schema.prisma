// MN Shoes & Watches — database schema
// SQLite (one file, opened through better-sqlite3 in WAL mode), Prisma ORM 7.
//
// Conventions
// - Money is integer paise (₹1 = 100). Percentages and tax rates are basis points (18% = 1800).
// - DateTime values are stored in UTC; the app shows them in IST.
// - SQLite does not enforce text lengths or case-insensitive matching, so the shared Zod schemas
//   cap every text field, and emails (lower-case) and coupon codes (upper-case) are normalised
//   before they are written or looked up.
// - Product search uses an FTS5 index in a separate file (search.db) next to this database.
//   Prisma would try to drop an FTS5 table in every new migration, so the index lives outside
//   Prisma's view. It is derived from Product.searchText and can be rebuilt at any time.
// - storeId is on every business table and defaults to the single store "main". It is a plain
//   indexed column for now: going multi-store later means adding a Store foreign key and a
//   tenant-scoping Prisma extension, not reshaping tables. Unique keys that must become
//   per-store (slugs, SKUs, order numbers, coupon codes) already include storeId.
//   Left without storeId: auth sessions/accounts/verifications (scoped through their user),
//   pure join tables (scoped through both sides) and the national PIN code directory.
// - Rich text is stored twice: Tiptap JSON for the editor, sanitised HTML for rendering.
// - contentUpdatedAt changes only when something a shopper or crawler sees changes; it feeds
//   sitemap lastmod. updatedAt changes on every write.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────────
// Store, settings, integrations, locations
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id        String   @id
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per store: everything under Settings that is not a list.
model StoreSettings {
  storeId String @id @default("main")

  storeName    String
  legalName    String?
  email        String
  phone        String
  whatsapp     String?
  gstin        String?
  gstStateCode String  @default("24") // Gujarat; same state as delivery = CGST + SGST, else IGST
  foundedYear  Int?
  trustStats   Json? // [{ label, value }] typed by the owner for the trust bar; never generated
  socialLinks  Json? // { instagram, facebook, youtube, x, googleBusinessProfile }; also JSON-LD sameAs

  logoId           String?
  logo             Media?  @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  logoDarkId       String?
  logoDark         Media?  @relation("SettingsLogoDark", fields: [logoDarkId], references: [id], onDelete: SetNull)
  faviconId        String?
  favicon          Media?  @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  defaultOgImageId String?
  defaultOgImage   Media?  @relation("SettingsOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)

  announcementEnabled Boolean @default(false)
  announcementText    String?
  announcementHref    String?
  announcementVersion Int     @default(1) // bump to show the bar again to shoppers who dismissed it

  freeShippingThreshold Int? // null = no free shipping
  dispatchCutoffHour    Int     @default(14) // IST; orders after this count from the next working day
  processingDays        Int     @default(1)
  holidays              Json? // ["2026-11-08", ...] dates with no dispatch
  codEnabled            Boolean @default(true)
  codFee                Int     @default(0)
  codMinOrder           Int?
  codMaxOrder           Int?
  codVerifyAbove        Int? // COD orders above this total need OTP or WhatsApp confirmation

  returnsEnabled   Boolean       @default(true)
  exchangesEnabled Boolean       @default(true)
  returnWindowDays Int           @default(7)
  returnFeeType    ReturnFeeType @default(FREE)
  returnFee        Int           @default(0)

  lowStockThreshold      Int @default(5)
  reviewRequestDelayDays Int @default(5)

  productTitleTemplate       String? // null = built-in "{brand} {name} – {colour} | {store}"
  productDescriptionTemplate String?
  categoryTitleTemplate      String?
  crawlerRules               Json? // [{ userAgent, allow }] for robots.txt, incl. AI search crawlers
  ga4MeasurementId           String?
  metaPixelId                String?
  googleSiteVerification     String?
  bingSiteVerification       String?
  webVitalsSampleRate        Int     @default(100) // percent of page views that report Web Vitals

  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?

  invoicePrefix String  @default("MN")
  invoiceFooter String?

  privacyPolicyVersion Int @default(1) // bump when the policy changes; consent is asked again

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Payment, shipping and messaging provider keys entered in Settings.
/// secretCipher is AES-256-GCM encrypted with APP_ENCRYPTION_KEY and never sent to a browser.
model Integration {
  id           String              @id @default(cuid())
  storeId      String              @default("main")
  provider     IntegrationProvider
  isEnabled    Boolean             @default(false)
  isLive       Boolean             @default(false) // false = test or sandbox keys
  publicConfig Json? // non-secret values: Razorpay key_id, Shiprocket pickup location name
  secretCipher String?
  updatedAt    DateTime            @updatedAt
  updatedById  String?

  @@unique([storeId, provider])
}

/// Physical shops. The primary one feeds the footer, Contact page and LocalBusiness JSON-LD.
model StoreLocation {
  id               String   @id @default(cuid())
  storeId          String   @default("main")
  name             String
  slug             String // /stores/kalol
  isPrimary        Boolean  @default(false)
  line1            String
  line2            String?
  landmark         String?
  city             String
  district         String?
  state            String
  stateCode        String
  pinCode          String
  latitude         Float?
  longitude        Float?
  phone            String
  whatsapp         String?
  openingHours     Json // [{ days: ["Mo","Tu"], opens: "10:00", closes: "21:00" }]
  mapUrl           String?
  googlePlaceId    String?
  directions       String?
  intro            Json?
  introHtml        String?
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean  @default(true)
  contentUpdatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  photos StoreLocationPhoto[]

  @@unique([storeId, slug])
}

model StoreLocationPhoto {
  locationId String
  location   StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position   Int           @default(0)

  @@id([locationId, mediaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Staff (admin) and their auth tables — separate from customers: own cookie,
// own sign-in page, email + password + TOTP. Table shapes follow Better Auth.
// ─────────────────────────────────────────────────────────────────────────────

model StaffUser {
  id               String    @id @default(cuid())
  storeId          String    @default("main")
  name             String
  email            String    @unique // Better Auth looks users up and updates them by email alone
  emailVerified    Boolean   @default(false)
  image            String?
  role             StaffRole @default(ORDER_STAFF)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false) // Owner and Manager cannot open the admin until this is on
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions       StaffSession[]
  accounts       StaffAccount[]
  twoFactors     StaffTwoFactor[]
  auditLogs      AuditLog[]
  drafts         AdminDraft[]
  uploads        Media[]
  orderEvents    OrderEvent[]
  customerNotes  CustomerNote[]
  stockMovements StockMovement[]
}

model StaffSession {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model StaffAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Argon2id hash
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model StaffVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model StaffTwoFactor {
  id                      String    @id @default(cuid())
  secret                  String // encrypted by Better Auth
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? // lockout after repeated wrong codes
  userId                  String
  user                    StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers and their auth tables (email OTP, Google, optional phone OTP)
// ─────────────────────────────────────────────────────────────────────────────

/// A shopper. Guest checkouts create a row too (hasAccount = false) so the owner sees every
/// buyer; signing in later with the same email or phone turns it into an account.
model Customer {
  id                  String    @id @default(cuid())
  storeId             String    @default("main")
  name                String
  email               String    @unique // Better Auth looks users up and updates them by email alone
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique // verified sign-in phone, E.164
  phoneNumberVerified Boolean   @default(false)
  phone               String? // contact phone from checkout, may be unverified
  hasAccount          Boolean   @default(false)
  acceptsEmail        Boolean   @default(false)
  acceptsWhatsapp     Boolean   @default(false)
  razorpayCustomerId  String? // saved cards and UPI stay in Razorpay's vault
  orderCount          Int       @default(0)
  totalSpent          Int       @default(0) // net of refunds
  firstOrderAt        DateTime?
  lastOrderAt         DateTime?
  anonymizedAt        DateTime? // set when a deletion request is completed
  isDemo              Boolean   @default(false) // seeded demo record; removed by Settings → Remove demo data
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      CustomerSession[]
  accounts      CustomerAccount[]
  addresses     CustomerAddress[]
  notes         CustomerNote[]
  carts         Cart[]
  wishlistItems WishlistItem[]
  orders        Order[]
  returns       ReturnRequest[]
  reviews       Review[]
  questions     ProductQuestion[]
  dataRequests  DataRequest[]
  redemptions   DiscountRedemption[]

  @@index([storeId, lastOrderAt])
  @@index([storeId, totalSpent])
  @@index([storeId, phone])
}

model CustomerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      Customer @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String // "google", "email-otp", "phone-number"
  userId                String
  user                  Customer  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // unused for customers; kept for Better Auth compatibility
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model CustomerVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  storeId    String   @default("main")
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String? // Home, Work
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  stateCode  String
  pinCode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model CustomerNote {
  id         String     @id @default(cuid())
  storeId    String     @default("main")
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime   @default(now())

  @@index([customerId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tax
// ─────────────────────────────────────────────────────────────────────────────

/// HSN code plus GST rate slabs, set by the owner with their accountant. Slabs exist because
/// the GST rate on some goods (footwear, for one) depends on the price per unit.
model TaxClass {
  id         String    @id @default(cuid())
  storeId    String    @default("main")
  name       String // Footwear, Watches, Perfumes
  hsnCode    String
  verifiedAt DateTime? // set when the owner confirms code and rates with their accountant; the admin warns until then
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  slabs      TaxSlab[]
  categories Category[]
  products   Product[]

  @@unique([storeId, name])
}

model TaxSlab {
  id           String   @id @default(cuid())
  storeId      String   @default("main")
  taxClassId   String
  taxClass     TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  maxUnitValue Int? // taxable value per unit (price excl. GST) up to which this slab applies; null = no limit
  rateBp       Int // 500 = 5%, 1800 = 18%

  @@index([taxClassId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Attributes: templates per product type, filterable values
// ─────────────────────────────────────────────────────────────────────────────

/// Shoes, Watches, Perfumes, Accessories: which attributes a product of this type has.
model AttributeTemplate {
  id        String   @id @default(cuid())
  storeId   String   @default("main")
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes TemplateAttribute[]
  categories Category[]
  products   Product[]

  @@unique([storeId, code])
}

model TemplateAttribute {
  templateId  String
  template    AttributeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  position    Int               @default(0)
  isRequired  Boolean           @default(false)

  @@id([templateId, attributeId])
}

model Attribute {
  id            String        @id @default(cuid())
  storeId       String        @default("main")
  code          String // dial_size_mm
  name          String // Dial size
  type          AttributeType
  unit          String? // mm, ml, m
  isVariantAxis Boolean       @default(false) // can generate variants: size, colour, volume
  isFilterable  Boolean       @default(true)
  filterStyle   FilterStyle   @default(CHECKBOX)
  helpText      String?
  position      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  values          AttributeValue[]
  templates       TemplateAttribute[]
  productValues   ProductAttributeValue[]
  productOptions  ProductOption[]
  categoryFilters CategoryFilter[]

  @@unique([storeId, code])
}

model AttributeValue {
  id          String    @id @default(cuid())
  storeId     String    @default("main")
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String // "UK 8", "Tan", "Stainless steel"
  slug        String // filter URLs: ?colour=tan
  swatchHex   String? // product colour swatch; catalogue data, not a UI colour
  sortKey     Float? // numeric order for sizes (8.5) and volumes (100)
  position    Int       @default(0)

  productValues ProductAttributeValue[]
  variantValues VariantOptionValue[]
  productMedia  ProductMedia[]

  @@unique([attributeId, slug])
}

// ─────────────────────────────────────────────────────────────────────────────
// Categories, brands, size charts
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id                  String             @id @default(cuid())
  storeId             String             @default("main")
  parentId            String?
  parent              Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]         @relation("CategoryTree")
  name                String
  slug                String
  path                String // "mens-shoes/formal/oxfords" = the URL; rebuilt when an ancestor's slug changes
  depth               Int                @default(0)
  position            Int                @default(0)
  isActive            Boolean            @default(true)
  showInMenu          Boolean            @default(true)
  intro               String? // 60–120 words above the grid, opening with a plain definition
  buyingGuide         Json?
  buyingGuideHtml     String?
  faqs                Json? // [{ question, answer }] → FAQPage
  imageId             String?
  image               Media?             @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  bannerId            String?
  banner              Media?             @relation("CategoryBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  attributeTemplateId String?
  attributeTemplate   AttributeTemplate? @relation(fields: [attributeTemplateId], references: [id], onDelete: SetNull)
  taxClassId          String?
  taxClass            TaxClass?          @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  sizeChartId         String?
  sizeChart           SizeChart?         @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  metaTitle           String?
  metaDescription     String?
  ogImageId           String?
  ogImage             Media?             @relation("CategoryOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl        String?
  noindex             Boolean            @default(false)
  contentUpdatedAt    DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  products        CategoryProduct[]
  primaryProducts Product[]         @relation("PrimaryCategory")
  filters         CategoryFilter[]
  discountTargets DiscountTarget[]
  posts           PostCategory[]

  @@unique([storeId, path])
  @@index([storeId, parentId, position])
}

/// Which attribute filters a category shows, in order. Price, brand and availability are built in.
model CategoryFilter {
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  position    Int       @default(0)

  @@id([categoryId, attributeId])
}

model Brand {
  id               String   @id @default(cuid())
  storeId          String   @default("main")
  name             String
  slug             String
  logoId           String?
  logo             Media?   @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  bannerId         String?
  banner           Media?   @relation("BrandBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  intro            String?
  description      Json?
  descriptionHtml  String?
  countryOfOrigin  String?
  website          String?
  isFeatured       Boolean  @default(false) // homepage brand strip
  isDemo           Boolean  @default(false) // seeded demo record; removed by Settings → Remove demo data
  isActive         Boolean  @default(true)
  position         Int      @default(0)
  faqs             Json?
  metaTitle        String?
  metaDescription  String?
  ogImageId        String?
  ogImage          Media?   @relation("BrandOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl     String?
  noindex          Boolean  @default(false)
  contentUpdatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products        Product[]
  discountTargets DiscountTarget[]

  @@unique([storeId, slug])
}

/// UK/EU/US size table plus "how to measure", attached to categories or individual products.
model SizeChart {
  id               String   @id @default(cuid())
  storeId          String   @default("main")
  name             String
  table            Json // { columns: ["UK","EU","US","Foot length (cm)"], rows: [["8","42","9","26.7"]] }
  howToMeasure     Json?
  howToMeasureHtml String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories Category[]
  products   Product[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Products and variants
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id                   String             @id @default(cuid())
  storeId              String             @default("main")
  title                String
  slug                 String // /product/{slug}; a change writes a 301 Redirect
  status               ProductStatus      @default(DRAFT)
  publishAt            DateTime? // for SCHEDULED
  publishedAt          DateTime?
  brandId              String?
  brand                Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  templateId           String?
  template             AttributeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  primaryCategoryId    String? // breadcrumbs and Merchant Center product_type
  primaryCategory      Category?          @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  gender               Gender?
  ageGroup             AgeGroup           @default(ADULT)
  condition            ProductCondition   @default(NEW)
  summary              String? // plain definitional opening sentence
  description          Json?
  descriptionHtml      String?
  highlights           Json? // ["Full-grain leather upper", "Resoleable Goodyear welt"]
  specs                Json? // extra key specs not covered by attributes: [{ label, value }]
  care                 String?
  warranty             String?
  warrantyMonths       Int?
  taxClassId           String? // overrides the category's tax class
  taxClass             TaxClass?          @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  hsnCode              String? // overrides the tax class HSN
  sizeChartId          String?
  sizeChart            SizeChart?         @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  replacementProductId String? // an ARCHIVED product 301s here
  replacement          Product?           @relation("Replacement", fields: [replacementProductId], references: [id], onDelete: SetNull)
  isFeatured           Boolean            @default(false)
  isDemo               Boolean            @default(false) // seeded demo record; removed by Settings → Remove demo data
  isPlaceholderPhoto   Boolean            @default(false) // generated SVG instead of a real photo; the admin asks for one
  videoUrl             String? // YouTube or Vimeo link shown in the gallery
  badges               Json? // ["Bestseller", "Limited edition"], shown on cards and the product page
  faqs                 Json?

  // Kept in sync from variants and orders so listing, sorting and filtering stay single-table
  minPrice        Int     @default(0)
  maxPrice        Int     @default(0)
  maxDiscountBp   Int     @default(0)
  inStock         Boolean @default(false)
  bestsellerScore Int     @default(0) // units sold in the last 90 days, refreshed nightly
  ratingAvg       Float   @default(0)
  ratingCount     Int     @default(0)
  searchText      String? // brand, categories, tags, attribute values; rebuilt on save and copied into search.db

  metaTitle        String?
  metaDescription  String?
  ogImageId        String?
  ogImage          Media?   @relation("ProductOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl     String?
  noindex          Boolean  @default(false)
  contentUpdatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants         ProductVariant[]
  options          ProductOption[]
  media            ProductMedia[]
  attributeValues  ProductAttributeValue[]
  categories       CategoryProduct[]
  collections      CollectionProduct[]
  tags             ProductTag[]
  relations        ProductRelation[]       @relation("RelationFrom")
  relatedFrom      ProductRelation[]       @relation("RelationTo")
  replacedProducts Product[]               @relation("Replacement")
  posts            PostProduct[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  questions        ProductQuestion[]
  discountTargets  DiscountTarget[]

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
  @@index([storeId, status, minPrice])
  @@index([storeId, status, bestsellerScore])
  @@index([storeId, brandId])
}

/// The axes a product's variants vary on (Size, Colour, Volume), in display order.
model ProductOption {
  id          String    @id @default(cuid())
  storeId     String    @default("main")
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  position    Int       @default(0)

  values VariantOptionValue[]

  @@unique([productId, attributeId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  storeId           String   @default("main")
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String
  gtin              String? // barcode: EAN-13, UPC-A or GTIN-14
  mpn               String?
  title             String // "UK 8 / Tan", built from the option values
  price             Int // GST-inclusive selling price
  compareAtPrice    Int?
  costPrice         Int? // private, for margin reports
  stockOnHand       Int      @default(0) // available = stockOnHand − active unexpired reservations
  lowStockThreshold Int? // null = store default
  weightGrams       Int?
  lengthCm          Int?
  breadthCm         Int?
  heightCm          Int?
  position          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  options          VariantOptionValue[]
  reservations     StockReservation[]
  movements        StockMovement[]
  backInStock      BackInStockRequest[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  exchangeRequests ReturnItem[]

  @@unique([storeId, sku])
  @@index([productId, position])
  @@index([storeId, gtin])
}

model VariantOptionValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    ProductOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  valueId   String
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([valueId])
}

/// Product-level attribute values (dial size, movement, notes). Multi-select attributes get one row per value.
model ProductAttributeValue {
  id          String          @id @default(cuid())
  storeId     String          @default("main")
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueId     String?
  value       AttributeValue? @relation(fields: [valueId], references: [id], onDelete: Cascade)
  numberValue Float?
  textValue   String?

  @@index([productId])
  @@index([attributeId, valueId])
  @@index([attributeId, numberValue])
}

model ProductMedia {
  id            String           @id @default(cuid())
  storeId       String           @default("main")
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  role          ProductMediaRole @default(GALLERY)
  position      Int              @default(0)
  optionValueId String? // shown when this colour (or volume) is picked; null = every variant
  optionValue   AttributeValue?  @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, role, position])
}

model CategoryProduct {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int      @default(0) // manual order inside the category

  @@id([categoryId, productId])
  @@index([productId])
}

model Tag {
  id      String @id @default(cuid())
  storeId String @default("main")
  name    String
  slug    String

  products ProductTag[]

  @@unique([storeId, slug])
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

/// Owner-picked links. "Similar products" are computed, not stored.
model ProductRelation {
  productId String
  product   Product             @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product             @relation("RelationTo", fields: [relatedId], references: [id], onDelete: Cascade)
  type      ProductRelationType
  position  Int                 @default(0)

  @@id([productId, relatedId, type])
  @@index([relatedId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media library
// ─────────────────────────────────────────────────────────────────────────────

model Media {
  id           String         @id @default(cuid())
  storeId      String         @default("main")
  kind         MediaKind
  source       MediaSource    @default(UPLOAD)
  storage      StorageDriver? // null for YouTube, Vimeo and Bunny Stream videos
  key          String? // storage path of the original, e.g. "2026/10/derby-tan-1.jpg"
  externalUrl  String?
  externalId   String?
  mimeType     String? // from the file's bytes, not its extension
  sizeBytes    Int?
  width        Int?
  height       Int?
  durationSec  Int?
  alt          String? // required before a product using the image can go live
  caption      String?
  blurDataUrl  String?
  crop         Json? // { x, y, width, height } from the admin cropper
  renditions   Json? // generated at upload: [{ width, format: "avif" | "webp", key, bytes }]
  checksum     String? // SHA-256, flags duplicate uploads
  originalName String?
  isDemo       Boolean        @default(false) // seeded demo record; removed by Settings → Remove demo data
  posterId     String? // videos must have one
  poster       Media?         @relation("VideoPoster", fields: [posterId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   StaffUser?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  usages MediaUsage[]

  // One back-relation per place a file can be used
  posterFor          Media[]              @relation("VideoPoster")
  settingsLogo       StoreSettings[]      @relation("SettingsLogo")
  settingsLogoDark   StoreSettings[]      @relation("SettingsLogoDark")
  settingsFavicon    StoreSettings[]      @relation("SettingsFavicon")
  settingsOgImage    StoreSettings[]      @relation("SettingsOgImage")
  locationPhotos     StoreLocationPhoto[]
  categoryImages     Category[]           @relation("CategoryImage")
  categoryBanners    Category[]           @relation("CategoryBanner")
  categoryOgImages   Category[]           @relation("CategoryOgImage")
  brandLogos         Brand[]              @relation("BrandLogo")
  brandBanners       Brand[]              @relation("BrandBanner")
  brandOgImages      Brand[]              @relation("BrandOgImage")
  productOgImages    Product[]            @relation("ProductOgImage")
  productMedia       ProductMedia[]
  collectionImages   Collection[]         @relation("CollectionImage")
  collectionOgImages Collection[]         @relation("CollectionOgImage")
  pageOgImages       Page[]               @relation("PageOgImage")
  postCovers         Post[]               @relation("PostCover")
  postOgImages       Post[]               @relation("PostOgImage")
  authorAvatars      Author[]
  bannerDesktop      Banner[]             @relation("BannerDesktop")
  bannerMobile       Banner[]             @relation("BannerMobile")
  bannerVideo        Banner[]             @relation("BannerVideo")
  menuItemImages     MenuItem[]
  reviewPhotos       ReviewPhoto[]
  returnPhotos       ReturnPhoto[]

  @@index([storeId, kind, createdAt])
  @@index([storeId, checksum])
}

/// Where each file is used, rebuilt whenever the using record is saved (covers images inside
/// rich text too). The media library refuses to delete a file that still has usages.
model MediaUsage {
  id         String @id @default(cuid())
  storeId    String @default("main")
  mediaId    String
  media      Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  entityType String // product, category, post, page, ...
  entityId   String
  field      String // gallery, description, ogImage

  @@unique([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Collections and search
// ─────────────────────────────────────────────────────────────────────────────

/// Manual lists or rule-based sets ("Watches under ₹5,000"). With landingPath set, the collection
/// is an indexable landing page at that URL (e.g. watches/men/under-5000); otherwise /collections/{slug}.
model Collection {
  id               String         @id @default(cuid())
  storeId          String         @default("main")
  title            String
  slug             String
  type             CollectionType @default(MANUAL)
  rules            Json? // [{ field: "price", op: "lte", value: 500000 }, { field: "category", op: "in", value: [...] }]
  matchAll         Boolean        @default(true)
  landingPath      String?
  isGiftGuide      Boolean        @default(false) // listed under /gift-guides
  defaultSort      ProductSort    @default(FEATURED)
  intro            String?
  description      Json?
  descriptionHtml  String?
  imageId          String?
  image            Media?         @relation("CollectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  isActive         Boolean        @default(true)
  faqs             Json?
  metaTitle        String?
  metaDescription  String?
  ogImageId        String?
  ogImage          Media?         @relation("CollectionOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl     String?
  noindex          Boolean        @default(false)
  contentUpdatedAt DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  products        CollectionProduct[]
  discountTargets DiscountTarget[]

  @@unique([storeId, slug])
  @@unique([storeId, landingPath])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

/// "sneker" → "sneakers" (one-way) or "chronograph" ↔ "chrono" (two-way).
model SearchSynonym {
  id      String  @id @default(cuid())
  storeId String  @default("main")
  term    String
  synonym String
  twoWay  Boolean @default(true)

  @@unique([storeId, term, synonym])
}

/// Aggregated search terms for popular-search suggestions and the zero-results report.
model SearchTerm {
  id              String   @id @default(cuid())
  storeId         String   @default("main")
  term            String // normalised: lower-case, trimmed
  searches        Int      @default(0)
  lastResultCount Int      @default(0)
  lastSearchedAt  DateTime @default(now())

  @@unique([storeId, term])
  @@index([storeId, searches])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────────────────────

/// Holds stock for 15 minutes from the start of checkout. Expired rows are ignored when
/// counting availability, so correctness never depends on a cleanup job running.
model StockReservation {
  id        String            @id @default(cuid())
  storeId   String            @default("main")
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartId    String?
  cart      Cart?             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([variantId, status, expiresAt])
  @@index([cartId])
  @@index([orderId])
}

model StockMovement {
  id           Int                 @id @default(autoincrement())
  storeId      String              @default("main")
  variantId    String
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       StockMovementReason
  orderId      String?
  returnId     String?
  note         String?
  staffId      String?
  staff        StaffUser?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([variantId, createdAt])
}

/// "Notify me" on out-of-stock sizes.
model BackInStockRequest {
  id         String         @id @default(cuid())
  storeId    String         @default("main")
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([variantId, email])
  @@index([variantId, notifiedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart and wishlist — keyed by a signed cookie, so they work for guests and follow the
// shopper across devices once signed in
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id              String     @id @default(cuid())
  storeId         String     @default("main")
  tokenHash       String     @unique // SHA-256 of the cookie token; the raw token is never stored
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          CartStatus @default(ACTIVE)
  email           String? // captured at checkout, used for cart reminders
  phone           String?
  couponCode      String?
  pinCode         String? // last PIN checked; drives delivery dates
  lastActivityAt  DateTime   @default(now())
  reminder1SentAt DateTime? // 1 hour
  reminder2SentAt DateTime? // 24 hours
  recoveredAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items        CartItem[]
  reservations StockReservation[]
  orders       Order[]

  @@index([storeId, status, lastActivityAt])
  @@index([customerId])
}

model CartItem {
  id            String         @id @default(cuid())
  storeId       String         @default("main")
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int
  savedForLater Boolean        @default(false)
  unitPriceSeen Int // price when added; a later change is pointed out in the cart
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model WishlistItem {
  id             String          @id @default(cuid())
  storeId        String          @default("main")
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestTokenHash String? // same cookie as the cart, until the shopper signs in
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@unique([storeId, customerId, productId])
  @@unique([storeId, guestTokenHash, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders, payments, invoices
// ─────────────────────────────────────────────────────────────────────────────

/// Created when the shopper presses Pay (status PENDING_PAYMENT) so Razorpay and webhooks have
/// something to point at. Pending orders are hidden from the admin list by default and expire.
model Order {
  id                  String             @id @default(cuid())
  storeId             String             @default("main")
  number              String // MN10421, shown to customers
  publicToken         String             @unique // confirmation page link for guests
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId              String?
  cart                Cart?              @relation(fields: [cartId], references: [id], onDelete: SetNull)
  email               String
  phone               String
  status              OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatus      @default(UNPAID)
  paymentMethod       OrderPaymentMethod
  source              OrderSource        @default(WEB)
  currency            String             @default("INR")
  subtotal            Int // line prices before discounts, GST-inclusive
  discountTotal       Int                @default(0)
  shippingTotal       Int                @default(0)
  codFee              Int                @default(0)
  taxTotal            Int                @default(0) // GST contained in grandTotal
  grandTotal          Int
  amountRefunded      Int                @default(0)
  couponCode          String?
  shippingMethod      String?
  deliveryMinDate     DateTime?
  deliveryMaxDate     DateTime?
  placeOfSupply       String // GST state code of the delivery address
  buyerGstin          String?
  customerNote        String?
  codVerifiedAt       DateTime?
  placedAt            DateTime? // payment captured, or COD order submitted
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  deliveredAt         DateTime?
  reviewRequestSentAt DateTime?
  idempotencyKey      String?            @unique // stops double submits
  ipAddress           String?
  userAgent           String?
  attribution         Json? // utm_* and referrer, only for shoppers who consented
  isDemo              Boolean            @default(false) // seeded demo record; removed by Settings → Remove demo data
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items        OrderItem[]
  addresses    OrderAddress[]
  events       OrderEvent[]
  payments     Payment[]
  refunds      Refund[]
  shipments    Shipment[]
  invoices     Invoice[]
  reservations StockReservation[]
  redemptions  DiscountRedemption[]
  returns      ReturnRequest[]      @relation("ReturnOrder")
  exchangeFor  ReturnRequest?       @relation("ExchangeOrder")

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([storeId, placedAt])
  @@index([storeId, phone])
  @@index([storeId, email])
  @@index([customerId])
}

model OrderAddress {
  id        String      @id @default(cuid())
  storeId   String      @default("main")
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      AddressType
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  stateCode String
  pinCode   String
  country   String      @default("IN")

  @@unique([orderId, type])
  @@index([pinCode])
}

/// A frozen copy of what was sold, so later catalogue edits never change an order or invoice.
model OrderItem {
  id               String          @id @default(cuid())
  storeId          String          @default("main")
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle     String
  variantTitle     String?
  brandName        String?
  sku              String
  imageKey         String?
  hsnCode          String
  gstRateBp        Int
  unitPrice        Int // GST-inclusive, before order-level discounts
  compareAtPrice   Int?
  quantity         Int
  discountAmount   Int             @default(0) // all discounts allocated to this line
  lineTotal        Int // unitPrice × quantity − discountAmount
  taxableValue     Int // lineTotal excluding GST
  taxAmount        Int // GST inside lineTotal; split CGST/SGST or IGST on the invoice
  quantityReturned Int             @default(0)
  createdAt        DateTime        @default(now())

  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  review        Review?

  @@index([orderId])
  @@index([variantId])
}

/// Status timeline, internal notes and every message sent about the order.
model OrderEvent {
  id         String     @id @default(cuid())
  storeId    String     @default("main")
  orderId    String
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // status_changed, note, payment_captured, whatsapp_sent
  message    String
  data       Json?
  actor      EventActor
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  isInternal Boolean    @default(false) // internal notes are never shown to the customer
  createdAt  DateTime   @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String               @id @default(cuid())
  storeId           String               @default("main")
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerOrderId   String? // Razorpay order_…
  providerPaymentId String? // Razorpay pay_…
  method            String? // upi, card, netbanking, wallet, emi, cod
  amount            Int
  status            PaymentAttemptStatus @default(CREATED)
  signatureVerified Boolean              @default(false)
  errorCode         String?
  errorReason       String?
  raw               Json?
  capturedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([providerOrderId])
  @@index([orderId])
}

model Refund {
  id               String         @id @default(cuid())
  storeId          String         @default("main")
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  returnId         String?
  return           ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  providerRefundId String?        @unique
  method           RefundMethod
  amount           Int
  status           RefundStatus   @default(PENDING)
  reason           String?
  staffId          String?
  processedAt      DateTime?
  createdAt        DateTime       @default(now())

  @@index([orderId])
}

/// GST tax invoices and credit notes. Numbers are gapless per financial year (see Counter).
model Invoice {
  id            String         @id @default(cuid())
  storeId       String         @default("main")
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnId      String? // credit notes raised for a return
  return        ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  type          InvoiceType
  number        String // MN/2026-27/000123
  financialYear String // 2026-27
  issuedAt      DateTime
  sellerGstin   String?
  buyerGstin    String?
  placeOfSupply String
  taxableTotal  Int
  cgstTotal     Int            @default(0)
  sgstTotal     Int            @default(0)
  igstTotal     Int            @default(0)
  grandTotal    Int
  lines         Json // the exact lines printed, with HSN, rate and tax split
  createdAt     DateTime       @default(now())

  @@unique([storeId, type, number])
  @@index([orderId])
}

/// Gapless counters: "order", "invoice:2026-27", "credit-note:2026-27", "return".
/// Incremented inside the same write transaction as the row that uses the number. SQLite allows one
/// writer at a time, so two orders can never take the same number.
model Counter {
  storeId   String @default("main")
  key       String
  nextValue Int    @default(1)

  @@id([storeId, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shipping
// ─────────────────────────────────────────────────────────────────────────────

/// Zones match on PIN prefix first, then state. Example: "Kalol & nearby" (PIN prefixes),
/// "Gujarat", "Metros", "Rest of India", "North-East, J&K, islands".
model ShippingZone {
  id          String   @id @default(cuid())
  storeId     String   @default("main")
  name        String
  stateCodes  Json // ["24"]
  pinPrefixes Json? // ["3824", "38272"]
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rates ShippingRate[]
}

model ShippingRate {
  id            String           @id @default(cuid())
  storeId       String           @default("main")
  zoneId        String
  zone          ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name          String // Standard delivery, Express
  code          String
  type          ShippingRateType @default(FLAT)
  price         Int // flat price, or base price for weight-based
  pricePerKg    Int? // each extra kg (or part) for weight-based
  minOrderValue Int?
  maxOrderValue Int?
  freeAbove     Int? // overrides the store-wide free-shipping threshold for this rate
  minDays       Int // transit days after dispatch
  maxDays       Int
  codAvailable  Boolean          @default(true)
  isActive      Boolean          @default(true)
  position      Int              @default(0)

  @@unique([zoneId, code])
}

/// Owner overrides by PIN or PIN prefix: not serviceable, no COD, extra days.
model PinCodeRule {
  id            String   @id @default(cuid())
  storeId       String   @default("main")
  pattern       String // "382721" or prefix "3827"
  isServiceable Boolean  @default(true)
  codAllowed    Boolean  @default(true)
  extraDays     Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([storeId, pattern])
}

/// National PIN directory (India Post open data) for city/state autofill at checkout.
/// Global reference data, so no storeId.
model PinCode {
  pin       String @id
  city      String
  district  String
  state     String
  stateCode String
}

model Shipment {
  id                 String            @id @default(cuid())
  storeId            String            @default("main")
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnId           String? // reverse pickup for a return or exchange
  return             ReturnRequest?    @relation(fields: [returnId], references: [id], onDelete: SetNull)
  direction          ShipmentDirection @default(FORWARD)
  provider           ShippingProvider
  providerOrderId    String?
  providerShipmentId String?
  awb                String?
  courierName        String?
  trackingUrl        String?
  status             ShipmentStatus    @default(PENDING)
  weightGrams        Int?
  lengthCm           Int?
  breadthCm          Int?
  heightCm           Int?
  labelUrl           String?
  manifestUrl        String?
  expectedDeliveryAt DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items  ShipmentItem[]
  events TrackingEvent[]

  @@index([storeId, status])
  @@index([orderId])
  @@index([awb])
}

model ShipmentItem {
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int

  @@id([shipmentId, orderItemId])
}

model TrackingEvent {
  id          Int             @id @default(autoincrement())
  storeId     String          @default("main")
  shipmentId  String
  shipment    Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus?
  rawStatus   String // courier's own wording
  location    String?
  description String?
  occurredAt  DateTime
  createdAt   DateTime        @default(now())

  @@index([shipmentId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Returns and size exchanges
// ─────────────────────────────────────────────────────────────────────────────

model ReturnRequest {
  id              String        @id @default(cuid())
  storeId         String        @default("main")
  number          String // R1042
  orderId         String
  order           Order         @relation("ReturnOrder", fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type            ReturnType
  status          ReturnStatus  @default(REQUESTED)
  reason          ReturnReason
  comment         String?
  refundMethod    RefundMethod?
  refundUpiId     String? // COD orders: where the customer wants the money
  refundAmount    Int?
  exchangeOrderId String?       @unique // the new order a size exchange creates
  exchangeOrder   Order?        @relation("ExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: SetNull)
  decisionNote    String?
  decidedById     String?
  decidedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       ReturnItem[]
  photos      ReturnPhoto[]
  shipments   Shipment[]
  refunds     Refund[]
  creditNotes Invoice[]

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([orderId])
}

model ReturnItem {
  id                String          @id @default(cuid())
  storeId           String          @default("main")
  returnId          String
  return            ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId       String
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity          Int
  exchangeVariantId String? // the size the customer wants instead
  exchangeVariant   ProductVariant? @relation(fields: [exchangeVariantId], references: [id], onDelete: SetNull)
  restocked         Boolean         @default(false)
  conditionNote     String?

  @@index([returnId])
}

model ReturnPhoto {
  returnId String
  return   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([returnId, mediaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────────────────────────────────────

/// A coupon (code set) or an automatic discount (code null).
model Discount {
  id                String        @id @default(cuid())
  storeId           String        @default("main")
  title             String // internal name
  code              String? // stored upper-case
  type              DiscountType
  value             Int // PERCENT: basis points; FLAT: paise; BUY_X_GET_Y: % off the "get" items in bp (10000 = free)
  maxDiscount       Int? // cap for percentage discounts
  minOrderValue     Int?
  minQuantity       Int?
  buyQuantity       Int?
  getQuantity       Int?
  scope             DiscountScope @default(ALL)
  usageLimit        Int?
  perCustomerLimit  Int? // counted by customer, email and phone so guests cannot repeat it
  usageCount        Int           @default(0)
  firstOrderOnly    Boolean       @default(false)
  prepaidOnly       Boolean       @default(false)
  combinable        Boolean       @default(false)
  startsAt          DateTime
  endsAt            DateTime?
  isActive          Boolean       @default(true)
  publicLabel       String? // "Flat ₹300 off watches above ₹4,999"
  showOnProductPage Boolean       @default(false)
  isDemo            Boolean       @default(false) // seeded demo record; removed by Settings → Remove demo data
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  targets     DiscountTarget[]
  redemptions DiscountRedemption[]

  @@unique([storeId, code])
  @@index([storeId, isActive, startsAt])
}

/// What a discount applies to. For buy-X-get-Y, QUALIFYING is the "buy" side, REWARD the "get" side.
/// Exactly one of productId, categoryId, collectionId, brandId is set.
model DiscountTarget {
  id           String             @id @default(cuid())
  discountId   String
  discount     Discount           @relation(fields: [discountId], references: [id], onDelete: Cascade)
  role         DiscountTargetRole @default(QUALIFYING)
  productId    String?
  product      Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  brandId      String?
  brand        Brand?             @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

model DiscountRedemption {
  id         String    @id @default(cuid())
  storeId    String    @default("main")
  discountId String
  discount   Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String
  phone      String?
  amount     Int
  createdAt  DateTime  @default(now())

  @@unique([discountId, orderId])
  @@index([discountId, email])
  @@index([discountId, phone])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews and questions — only real, moderated, on-site submissions
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(cuid())
  storeId         String       @default("main")
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItemId     String?      @unique
  orderItem       OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  authorName      String
  authorCity      String?
  rating          Int // 1–5
  title           String?
  body            String
  fit             FitFeedback? // shoes: runs small / true to size / runs large
  isVerifiedBuyer Boolean      @default(false) // true only when tied to a delivered order item
  isFeatured      Boolean      @default(false) // may appear on the homepage
  status          ReviewStatus @default(PENDING)
  reply           String? // the owner's public reply
  repliedAt       DateTime?
  repliedById     String?
  helpfulCount    Int          @default(0)
  isDemo          Boolean      @default(false) // seeded demo record; removed by Settings → Remove demo data
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  photos ReviewPhoto[]

  @@index([productId, status, publishedAt])
  @@index([storeId, status, createdAt])
}

model ReviewPhoto {
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@id([reviewId, mediaId])
}

model ProductQuestion {
  id           String         @id @default(cuid())
  storeId      String         @default("main")
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName   String
  email        String // private; used to send the answer
  question     String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  status       QuestionStatus @default(PENDING)
  helpfulCount Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([productId, status])
  @@index([storeId, status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Content: homepage builder, banners, pages, journal, navigation
// ─────────────────────────────────────────────────────────────────────────────

/// One row per homepage block. settings is validated by a Zod schema per type.
model HomeSection {
  id        String          @id @default(cuid())
  storeId   String          @default("main")
  type      HomeSectionType
  title     String?
  settings  Json?
  position  Int             @default(0)
  isEnabled Boolean         @default(true)
  updatedAt DateTime        @updatedAt

  @@index([storeId, position])
}

model Banner {
  id             String          @id @default(cuid())
  storeId        String          @default("main")
  placement      BannerPlacement
  title          String
  subtitle       String?
  ctaLabel       String?
  ctaHref        String?
  desktopImageId String?
  desktopImage   Media?          @relation("BannerDesktop", fields: [desktopImageId], references: [id], onDelete: SetNull)
  mobileImageId  String? // separate mobile crop
  mobileImage    Media?          @relation("BannerMobile", fields: [mobileImageId], references: [id], onDelete: SetNull)
  videoId        String? // muted loop; the desktop image doubles as its poster
  video          Media?          @relation("BannerVideo", fields: [videoId], references: [id], onDelete: SetNull)
  textTone       TextTone        @default(DARK) // text colour that reads on this image
  isDemo         Boolean         @default(false) // seeded demo record; removed by Settings → Remove demo data
  startsAt       DateTime?
  endsAt         DateTime?
  position       Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId, placement, position])
}

/// About, Contact, FAQ, policies and any other owner page.
model Page {
  id               String        @id @default(cuid())
  storeId          String        @default("main")
  kind             PageKind      @default(STANDARD)
  slug             String
  title            String
  content          Json?
  contentHtml      String?
  faqs             Json?
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?
  ogImageId        String?
  ogImage          Media?        @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl     String?
  noindex          Boolean       @default(false)
  contentUpdatedAt DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([storeId, slug])
}

model Author {
  id       String  @id @default(cuid())
  storeId  String  @default("main")
  name     String
  slug     String
  jobTitle String?
  bio      String?
  avatarId String?
  avatar   Media?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  sameAs   Json? // profile links for the Person entity
  isDemo   Boolean @default(false) // seeded demo record; removed by Settings → Remove demo data

  posts Post[]

  @@unique([storeId, slug])
}

model PostTopic {
  id      String @id @default(cuid())
  storeId String @default("main")
  name    String // Buying guides, Care, Style
  slug    String

  posts Post[]

  @@unique([storeId, slug])
}

model Post {
  id               String        @id @default(cuid())
  storeId          String        @default("main")
  title            String
  slug             String
  excerpt          String?
  content          Json?
  contentHtml      String?
  coverId          String?
  cover            Media?        @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  authorId         String
  author           Author        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  topicId          String?
  topic            PostTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  readingMinutes   Int?
  isDemo           Boolean       @default(false) // seeded demo record; removed by Settings → Remove demo data
  faqs             Json?
  metaTitle        String?
  metaDescription  String?
  ogImageId        String?
  ogImage          Media?        @relation("PostOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl     String?
  noindex          Boolean       @default(false)
  contentUpdatedAt DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  products   PostProduct[]
  categories PostCategory[]

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
}

/// Products a guide mentions; gives each product page a link back to the guide.
model PostProduct {
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

/// Categories a guide covers; shown as "Read the guide" on the category page.
model PostCategory {
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

/// Main mega menu and footer columns, edited in the navigation editor.
model Menu {
  id      String @id @default(cuid())
  storeId String @default("main")
  handle  String // main, footer-shop, footer-help, footer-policies
  name    String

  items MenuItem[]

  @@unique([storeId, handle])
}

model MenuItem {
  id            String      @id @default(cuid())
  storeId       String      @default("main")
  menuId        String
  menu          Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        MenuItem?   @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      MenuItem[]  @relation("MenuTree")
  label         String
  linkType      NavLinkType
  targetId      String? // category, brand, collection, page or post id; resolved to its current URL
  url           String? // for linkType URL
  imageId       String? // mega-menu dropdown image
  image         Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  isHighlighted Boolean     @default(false) // e.g. Sale, shown in the accent colour
  position      Int         @default(0)

  @@index([menuId, parentId, position])
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO tools
// ─────────────────────────────────────────────────────────────────────────────

model Redirect {
  id         String         @id @default(cuid())
  storeId    String         @default("main")
  fromPath   String // "/product/old-slug", no domain or query
  toPath     String
  statusCode Int            @default(301) // 301, 302 or 410
  source     RedirectSource @default(MANUAL)
  hits       Int            @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([storeId, fromPath])
}

/// Findings from the nightly SEO audit: missing alt text, missing meta, thin intros, broken links.
model SeoIssue {
  id         String       @id @default(cuid())
  storeId    String       @default("main")
  type       SeoIssueType
  entityType String
  entityId   String
  detail     String
  detectedAt DateTime     @default(now())
  resolvedAt DateTime?

  @@index([storeId, type, resolvedAt])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging, jobs, newsletter, contact
// ─────────────────────────────────────────────────────────────────────────────

/// Owner-editable wording for each automatic message. Email layout lives in code (React Email);
/// WhatsApp messages use a template the provider has approved.
model MessageTemplate {
  id                   String         @id @default(cuid())
  storeId              String         @default("main")
  key                  String // order_placed, order_shipped, cart_reminder_1, review_request
  channel              MessageChannel
  isEnabled            Boolean        @default(true)
  subject              String?
  preheader            String?
  intro                String?
  providerTemplateName String?
  updatedAt            DateTime       @updatedAt

  @@unique([storeId, key, channel])
}

model MessageLog {
  id                Int            @id @default(autoincrement())
  storeId           String         @default("main")
  channel           MessageChannel
  templateKey       String
  recipient         String
  subject           String?
  status            MessageStatus  @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  orderId           String?
  customerId        String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([providerMessageId])
}

/// Database-backed job queue, drained by a once-a-minute cron call to /api/cron.
/// Works on shared hosting where no long-running worker is allowed.
model Job {
  id          String    @id @default(cuid())
  storeId     String    @default("main")
  type        String // send_message, cart_reminder, review_request, publish_scheduled, seo_audit
  payload     Json?
  runAt       DateTime  @default(now())
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique // e.g. "cart_reminder_1:{cartId}"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model NewsletterSubscriber {
  id             String             @id @default(cuid())
  storeId        String             @default("main")
  email          String
  status         SubscriptionStatus @default(SUBSCRIBED)
  source         String? // footer, checkout, account
  consentedAt    DateTime           @default(now())
  unsubscribedAt DateTime?

  @@unique([storeId, email])
}

model ContactMessage {
  id        String        @id @default(cuid())
  storeId   String        @default("main")
  name      String
  email     String?
  phone     String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([storeId, status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Privacy (DPDP Act 2023)
// ─────────────────────────────────────────────────────────────────────────────

/// Proof of each cookie/tracking choice: what was shown (policy version) and what was chosen.
model ConsentRecord {
  id            Int      @id @default(autoincrement())
  storeId       String   @default("main")
  visitorId     String // random id held in the consent cookie
  customerId    String?
  analytics     Boolean
  marketing     Boolean
  policyVersion Int
  ipHash        String? // salted SHA-256; the raw IP is not kept
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([visitorId])
  @@index([customerId])
}

model DataRequest {
  id          String            @id @default(cuid())
  storeId     String            @default("main")
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  note        String?
  fileKey     String? // export archive, deleted after 7 days
  handledById String?
  requestedAt DateTime          @default(now())
  completedAt DateTime?

  @@index([storeId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// System: audit log, admin drafts, rate limits, webhooks, Web Vitals
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int        @id @default(autoincrement())
  storeId    String     @default("main")
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action     String // product.update, order.refund, settings.payments.update
  entityType String
  entityId   String?
  summary    String?
  changes    Json? // { field: [before, after] }; secrets are masked
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([storeId, createdAt])
  @@index([entityType, entityId])
  @@index([staffId, createdAt])
}

/// Autosaved, unpublished edits from admin forms.
model AdminDraft {
  id         String    @id @default(cuid())
  storeId    String    @default("main")
  staffId    String
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String? // null while creating something new
  data       Json
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, entityType, entityId])
}

/// Shared by Better Auth and our own limits (OTP, coupon, checkout). Kept in the database because
/// shared hosts can run several Node processes, which would each keep their own memory counters.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest Float // epoch ms; Float keeps it a JS number (BigInt would break Better Auth arithmetic)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  storeId     String    @default("main")
  provider    String // razorpay, shiprocket, whatsapp
  eventId     String // provider's event id, or a hash of the body when it has none
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?

  @@unique([provider, eventId])
  @@index([processedAt])
}

/// Real-user Core Web Vitals, sampled; p75 per page type is shown on the dashboard. Pruned after 90 days.
model WebVital {
  id        Int          @id @default(autoincrement())
  storeId   String       @default("main")
  name      WebVitalName
  value     Float
  rating    VitalRating
  pageType  String // home, category, product, cart, checkout, other
  path      String
  device    String // mobile, desktop
  createdAt DateTime     @default(now())

  @@index([storeId, name, createdAt])
  @@index([storeId, pageType, createdAt])
}

